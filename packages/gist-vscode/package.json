{
  "name": "gist-lang",
  "displayName": "GIST Language",
  "description": "Language support for GIST (Generative Intent Specification Toolkit)",
  "version": "0.1.0",
  "publisher": "gist-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:gist"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "syntaxes",
    "language-configuration.json",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gist",
        "aliases": ["GIST", "gist"],
        "extensions": [".gist"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gist",
        "scopeName": "source.gist",
        "path": "./syntaxes/gist.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gist-lang/gist-lang.git",
    "directory": "packages/gist-vscode"
  },
  "homepage": "https://github.com/gist-lang/gist-lang/tree/main/packages/gist-vscode",
  "bugs": "https://github.com/gist-lang/gist-lang/issues",
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch"
  }
}
