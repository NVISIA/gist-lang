{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GIST",
  "scopeName": "source.gist",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#context-lines" },
    { "include": "#project-declaration" },
    { "include": "#declaration-keywords" },
    { "include": "#control-keywords" },
    { "include": "#constraint-keywords" },
    { "include": "#metadata-keywords" },
    { "include": "#behavior-keywords" },
    { "include": "#test-keywords" },
    { "include": "#http-methods" },
    { "include": "#modifiers" },
    { "include": "#primitive-types" },
    { "include": "#literal-values" },
    { "include": "#type-names" },
    { "include": "#constants" },
    { "include": "#durations" },
    { "include": "#numbers" },
    { "include": "#route-paths" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gist",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gist",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gist",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gist",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "context-lines": {
      "patterns": [
        {
          "name": "comment.context.gist",
          "match": "^(\\s*)>\\s.*$"
        }
      ]
    },
    "project-declaration": {
      "patterns": [
        {
          "match": "^(project)\\s+(\\w+)",
          "captures": {
            "1": { "name": "keyword.control.gist" },
            "2": { "name": "entity.name.namespace.gist" }
          }
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.gist",
          "match": "\\b(to|fn|flow|on)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.gist",
          "match": "\\b(project|module|kit|stack|state|for|test|use|extend|refine|pass)\\b"
        }
      ]
    },
    "constraint-keywords": {
      "patterns": [
        {
          "name": "keyword.constraint.gist",
          "match": "\\b(always|must|ensure|across)\\b"
        }
      ]
    },
    "metadata-keywords": {
      "patterns": [
        {
          "name": "keyword.other.gist",
          "match": "\\b(route|guard|saves|emits|uses|schedule|needs|do|code|fails|eg|stage|compensate|given|call|trigger|then|expect|public|async|trace|style|rules|before|after|when|retain|ttl|socket)\\b"
        }
      ]
    },
    "behavior-keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.gist",
          "match": "\\b(if|else|for\\s+each|continue|try|or|match)\\b"
        }
      ]
    },
    "test-keywords": {
      "patterns": [
        {
          "name": "keyword.other.test.gist",
          "match": "\\b(as|in|fail|client|receives)\\b"
        }
      ]
    },
    "http-methods": {
      "patterns": [
        {
          "name": "keyword.operator.http.gist",
          "match": "\\b(GET|POST|PUT|PATCH|DELETE)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.gist",
          "match": "\\b(generated|unique|secret|computed|ephemeral|immutable)\\b"
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "support.type.primitive.gist",
          "match": "\\b(string|int|float|decimal|number|bool|date|datetime|bytes|any|void|result|map|error)\\b"
        }
      ]
    },
    "literal-values": {
      "patterns": [
        {
          "name": "constant.language.gist",
          "match": "\\b(true|false|null|unlimited|now|forever)\\b"
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.gist",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.gist",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.gist",
          "match": "\\b\\d+[smhd]\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gist",
          "match": "-?\\d+\\.\\d+"
        },
        {
          "name": "constant.numeric.integer.gist",
          "match": "-?\\d+"
        }
      ]
    },
    "route-paths": {
      "patterns": [
        {
          "match": "(/[a-zA-Z0-9_/:.-]+)",
          "captures": {
            "1": { "name": "string.other.route.gist" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gist",
          "match": "(->|\\.\\.\\.|\\|)"
        }
      ]
    }
  }
}
